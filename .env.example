# Server Configuration
NODE_ENV=production
PORT=3000

# MongoDB Atlas Free M0 Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gta-world?retryWrites=true&w=majority
MONGODB_URI=

# Cookie Signing Secret (set a strong random string in Render Environment Variables)
COOKIE_SECRET=replace-with-a-long-random-secret

# Optional CORS Origin (leave blank when frontend & backend are served from the same Render URL)
CLIENT_ORIGIN=
