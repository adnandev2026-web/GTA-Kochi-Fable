rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isValidPlayer(data) {
      return data.keys().hasAll([
          'uid',
          'characterName',
          'deviceMode',
          'cityId',
          'homeId',
          'money',
          'ownedVehicles',
          'selectedVehicle',
          'playTimeSeconds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'characterName',
          'deviceMode',
          'cityId',
          'homeId',
          'money',
          'ownedVehicles',
          'selectedVehicle',
          'playTimeSeconds',
          'finesTotal',
          'tollsTotal',
          'appearance',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 80))
        && data.characterName is string && data.characterName.size() >= 1 && data.characterName.size() <= 40
        && data.deviceMode in ['mobile', 'laptop', 'desktop']
        && data.cityId is string && data.cityId.size() >= 1 && data.cityId.size() <= 40
        && data.homeId is string && data.homeId.size() >= 1 && data.homeId.size() <= 64
        && data.money is number && data.money >= 0 && data.money <= 100000000
        && data.ownedVehicles is list && data.ownedVehicles.size() >= 1 && data.ownedVehicles.size() <= 20 && data.ownedVehicles[0] is string
        && data.selectedVehicle is string && data.selectedVehicle.size() >= 1 && data.selectedVehicle.size() <= 40
        && data.playTimeSeconds is number && data.playTimeSeconds >= 0
        && (!('finesTotal' in data) || (data.finesTotal is number && data.finesTotal >= 0))
        && (!('tollsTotal' in data) || (data.tollsTotal is number && data.tollsTotal >= 0))
        && (!('appearance' in data) || (data.appearance is map && data.appearance.keys().size() <= 20));
    }

    match /players/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidPlayer(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidPlayer(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'characterName',
          'deviceMode',
          'cityId',
          'homeId',
          'money',
          'ownedVehicles',
          'selectedVehicle',
          'playTimeSeconds',
          'finesTotal',
          'tollsTotal',
          'appearance',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
